# Emoji Mapper environment configuration.
# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# --- Pack owner (required) ---
# Your numeric Telegram user id. Custom-emoji sets are OWNED by this user.
# You must press Start on each bot below at least once.
PACK_OWNER_USER_ID=

# --- Crypto-coin bot (original workflow) ---
# Bot API token used to build the crypto-coin emoji packs.
TELEGRAM_BOT_TOKEN=

# --- General emoji bot (any non-coin pack) ---
# Bot API token for arbitrary emoji packs. Select it at runtime with
#   build_pack.py --token-env GENERAL_BOT_TOKEN
# The bot's username and display name are NOT configured here: every tool reads
# them from getMe at runtime, so a stale copy can never name the wrong bot in a
# set name.
GENERAL_BOT_TOKEN=

# --- Optional: who may use the emoji bot ---
# Comma-separated numeric Telegram user ids allowed to talk to emoji_bot.py.
# Leave empty to allow only PACK_OWNER_USER_ID. The bot refuses to start when
# neither is set: an unset allowlist means "nobody", never "everybody".
BOT_ALLOWED_USER_IDS=

# --- Optional: where finished-pack links are announced ---
# A channel id (e.g. -1001234567890) or @channelusername. The bot must be an
# ADMINISTRATOR of that channel to post there. Leave empty to send the links to
# PACK_OWNER_USER_ID's private chat, which is the previous behaviour.
PACK_LINKS_CHAT_ID=

# --- Optional: log retention ---
# Every run writes its own file under logs/. Files older than this many days are
# pruned at startup; set 0 to keep everything.
EMOJI_LOG_RETENTION_DAYS=30

# --- Optional: ffmpeg/ffprobe wall-clock limit ---
# Seconds allowed per ffmpeg/ffprobe child process (emojikit/media.py). A 3 s
# emoji encode takes under a second; the limit exists so one wedged child cannot
# hang a whole run. Minimum 1; an unparsable value falls back to the default.
EMOJI_FFMPEG_TIMEOUT=300

# --- Optional: CoinMarketCap Pro API key (crypto logo fallback) ---
# Only needed by fetch_cmc.py for the few coins missing on CoinGecko/CoinPaprika.
CMC_API_KEY=

# --- Advanced: Bot API endpoint override ---
# Every Telegram call is built on this base (default https://api.telegram.org).
# Point it at a local test server to exercise the client without touching
# Telegram. Leave it unset for normal use.
#TELEGRAM_API_BASE=https://api.telegram.org

# --- Advanced: skip .env loading entirely (environment-only switch) ---
# EMOJI_MAPPER_NO_DOTENV=1 makes build_pack.load_env() a no-op, so no file on
# disk can put credentials back into a process. The test suite sets it in the
# real environment; setting it *inside this file* does nothing, because it is
# read before the file is.

# --- Cloudflare Worker (optional) --------------------------------------------
# Set BOTH to have the deployed Worker announce finished packs in the channel
# (the bot posts them) instead of this machine talking to Telegram directly.
# Leave unset for the original direct path. See worker/README.md.
WORKER_PUBLISH_URL=
WORKER_PUBLISH_SECRET=
#
# Channel for the Worker's IMPORTANT log lines (errors). Routine lines stay in
# its D1 table only. BOTH bots must be administrators of it: each posts its own
# lines, matching the [general] / [coin] tag every line starts with.
LOG_CHAT_ID=
#
# Explicit allow-list for the Worker bots, comma-separated plain integers.
# Blank = PACK_OWNER_USER_ID + BOT_ALLOWED_USER_IDS. Fails closed either way:
# no valid id means the bots answer nobody.
ADMIN_USER_IDS=
#
# Generated by worker\scripts\put-secrets.ps1 and written back here. Do not
# invent them by hand: a webhook secret that differs from the deployed one
# fails every delivery silently.
GENERAL_WEBHOOK_SECRET=
COIN_WEBHOOK_SECRET=
